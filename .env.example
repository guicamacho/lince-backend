# Primary Postgres (São Paulo / gru in prod)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lince

# Clerk (auth plumbing — no regulated PII crosses this boundary)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_…) from the Clerk dashboard webhook endpoint
CLERK_WEBHOOK_SIGNING_SECRET=

# Avenia (rail). Sandbox base includes the port; prod TBD.
AVENIA_BASE_URL=https://api.sandbox.avenia.io:10952
AVENIA_API_KEY=
# RSA private key (PKCS#1 v1.5, SHA-256) used to sign full path+query of every call
AVENIA_SIGNING_PRIVATE_KEY=

# Didit (KYC/KYB capture — STUB until vendor confirmations; see BUILD_BRIEF §3/§6)
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

# Step-up re-auth gate for sensitive mutations (POST /app/beneficiaries).
# Off unless exactly "true"; when on, requires a fresh Clerk strict reverification.
STEP_UP_ENFORCED=false

# Notifications outbox (B6). Email sending is OFF unless the adapter is "resend".
NOTIFY_EMAIL_ADAPTER=log            # log or resend; "log" never sends (dev/sandbox default)
NOTIFY_RESEND_API_KEY=              # Resend API key; only used when adapter is resend
NOTIFY_FROM=                        # From address for outbound email (adapter resend)
NOTIFY_REPLY_TO=                    # optional Reply-To for outbound email
NOTIFY_SLACK_WEBHOOK_URL=           # Slack incoming webhook for admin alerts (else logs)

# MFA policy (B15). Ruling: optional default, SMS disabled, 24h post-recovery hold.
MFA_POLICY=optional                 # optional or mandatory; flip to mandatory is config-only
MFA_SMS_ENABLED=false               # SMS second factor disabled (documented flag; Clerk mirror)
RECOVERY_HOLD_HOURS=24              # money-out hold window (hours) after full account recovery

# API rate limiting (B13). Off in dev unless exactly "true".
RATE_LIMIT_ENFORCED=false           # gate the limiter + 429s (dev/tests stay off)
WEBHOOK_MAX_BYTES=1mb               # express.json body cap for webhook intake (100kb default is too small)

# Inbound webhook signing secrets (B3 seams; schemes unconfirmed, verifiers stubbed).
RESEND_WEBHOOK_SECRET=              # Svix secret for Resend webhooks (whsec_...)
AVENIA_WEBHOOK_SECRET=              # Avenia inbound webhook secret (scheme TBD; stub)

# AU public-holiday overrides (CSV of YYYY-MM-DD) merged with the hardcoded
# national set — e.g. state-specific days or WA's Anzac Day substitute.
AU_HOLIDAYS=

# Shared service token for server-to-server /admin/* calls from the admin app
# (which authenticates staff via its own, separate Clerk instance).
ADMIN_SERVICE_TOKEN=

# Admission SLA threshold (days) for the aging/breach instrument (PRD-04 §4.3).
# Wall-clock; default 2. Drives env.sla.admissionDays.
ADMISSION_SLA_DAYS=2
