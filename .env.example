# Primary Postgres (São Paulo / gru in prod)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lince

# Clerk (auth plumbing — no regulated PII crosses this boundary)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_…) from the Clerk dashboard webhook endpoint
CLERK_WEBHOOK_SIGNING_SECRET=

# Avenia (rail). Sandbox base includes the port; prod TBD.
AVENIA_BASE_URL=https://api.sandbox.avenia.io:10952
AVENIA_API_KEY=
# RSA private key (PKCS#1 v1.5, SHA-256) used to sign full path+query of every call
AVENIA_SIGNING_PRIVATE_KEY=

# Didit (KYC/KYB capture — STUB until vendor confirmations; see BUILD_BRIEF §3/§6)
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

# Step-up re-auth gate for sensitive mutations (POST /app/beneficiaries).
# Off unless exactly "true"; when on, requires a fresh Clerk strict reverification.
STEP_UP_ENFORCED=false

# AU public-holiday overrides (CSV of YYYY-MM-DD) merged with the hardcoded
# national set — e.g. state-specific days or WA's Anzac Day substitute.
AU_HOLIDAYS=

# Shared service token for server-to-server /admin/* calls from the admin app
# (which authenticates staff via its own, separate Clerk instance).
ADMIN_SERVICE_TOKEN=
